#!/bin/bash
#BSUB -J sfari_concord
#BSUB -o sfari_concord_%J.log
#BSUB -e sfari_concord_%J.err
#BSUB -P acc_ad-omics
#BSUB -q premium
#BSUB -n 16
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=32000]"
#BSUB -W 96:00
#
# CONCORD integration + label transfer (replaces the scVI/scANVI notebook step), on CPU.
# - 16 cores on one host (span[hosts=1]); PyTorch uses exactly the allocated cores.
# - Memory is per core (16 x 32 GB = 512 GB): the selected features of every cell (raw +
#   log-normalised) are held in memory during training.
# - CPU training is slower per epoch than on a GPU; a larger batch size shortens it, e.g.
#   CONCORD_ARGS="--batch-size 512" bsub < jobs/run_integrate_concord.lsf
#
# GPU instead: replace the queue/core lines above with
#   #BSUB -q gpu
#   #BSUB -gpu num=1
#   #BSUB -R a100
#   #BSUB -n 8
#   #BSUB -R "rusage[mem=64000]"
# and set CONCORD_ARGS="--device cuda".
#
# Submit from the repository root:  bsub < jobs/run_integrate_concord.lsf

source ~/.bashrc
conda activate "${CONDA_ENV:-concord}"   # export CONDA_ENV=/path/to/env before bsub if needed
export SFARI_ROOT="${SFARI_ROOT:-/sc/arion/projects/ad-omics/raphael/SFARI}"

# Keep every threaded library (PyTorch, BLAS, numba for UMAP) within the LSF allocation.
NCORES="${LSB_DJOB_NUMPROC:-16}"
export OMP_NUM_THREADS="$NCORES" MKL_NUM_THREADS="$NCORES" OPENBLAS_NUM_THREADS="$NCORES" NUMBA_NUM_THREADS="$NCORES"

cd "${LS_SUBCWD:-.}"
python pipeline/06_integrate_concord.py --device cpu --threads "$NCORES" ${CONCORD_ARGS:-}

# Downstream: see README.md (pipeline steps 07+). Then copy data/concord/build_info.json and
# data/concord/umap_subsample.parquet into the app's data/.
