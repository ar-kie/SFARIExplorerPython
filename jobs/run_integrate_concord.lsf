#!/bin/bash
#BSUB -J sfari_concord
#BSUB -o sfari_concord_%J.log
#BSUB -e sfari_concord_%J.err
#BSUB -P acc_ad-omics
#BSUB -q gpu
#BSUB -gpu num=1
#BSUB -R a100
#BSUB -n 8
#BSUB -R "rusage[mem=64000]"
#BSUB -W 24:00
#
# CONCORD integration + label transfer (replaces the scVI/scANVI notebook step).
# Memory is per core (8 x 64 GB = 512 GB): streaming the raw counts is light, but the selected
# features of every cell (raw + log-normalised) are held in memory during training.
# Check the current GPU resource names on Minerva (e.g. a100, h100nvl) before submitting.
#
# Submit from the repository root:  bsub < jobs/run_integrate_concord.lsf

source ~/.bashrc
conda activate "${CONDA_ENV:-concord}"   # export CONDA_ENV=/path/to/env before bsub if needed
export SFARI_ROOT="${SFARI_ROOT:-/sc/arion/projects/ad-omics/raphael/SFARI}"

cd "${LS_SUBCWD:-.}"
python pipeline/06_integrate_concord.py

# Downstream (unchanged logic, now reading combined_concord_label_transfer.h5ad):
#   see README.md (pipeline steps 07+)
# Then copy data/concord/build_info.json and data/concord/umap_subsample.parquet into the app's data/.
